# Configuration ConfidenceLD backend
#
# Copiez ce fichier en `.env` ou définissez ces variables sur votre plateforme d'hébergement.

# URL de connexion PostgreSQL (Supabase, Neon, Railway, ...)
DATABASE_URL=postgresql://postgres:postgres@db.supabase.co:5432/postgres?sslmode=require

# Mettre "false" si votre base n'utilise pas SSL
DATABASE_SSL=true

# Clé secrète pour signer les tokens JWT (changez-la !)
JWT_SECRET=changez-moi-par-une-longue-chaine-aleatoire

# Port du serveur (Render/Fly définissent PORT automatiquement)
PORT=3000